{
  "name": "nvuto-design-system",
  "version": "0.1.0-extraction.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "build": "npm run generate && vite build --config vite.library.config.ts && tsc -p packages/react/tsconfig.build.json && node scripts/scope-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "check": "npm run generate -- --check && npm run lint && npm run typecheck && npm run snippets:check && npm test",
    "catalogue": "npm run preview:catalogue",
    "build:catalogue": "npm run prepare:catalogue && vite build --config vite.catalogue.config.ts",
    "pack": "node scripts/pack.mjs",
    "test:consumer": "node scripts/independent-consumer.mjs",
    "test:browser": "playwright test",
    "prepublishOnly": "node scripts/block-publish.mjs",
    "prepare:catalogue": "node scripts/prepare-catalogue.mjs",
    "preview:catalogue": "vite preview --config vite.catalogue.config.ts --host 127.0.0.1 --port 5187 --strictPort",
    "catalogue:dev": "npm run prepare:catalogue && vite --config vite.catalogue.config.ts --host 127.0.0.1 --port 5187",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "resume:clean": "node scripts/resume-clean.mjs",
    "examples:generate": "node scripts/generate-complete-examples.mjs",
    "snippets:check": "node scripts/check-snippets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@tanstack/react-query": "5.101.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.2.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.12.1",
    "happy-dom": "20.11.2",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.81.0",
    "recharts": "2.15.2",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "playwright-core": "1.61.1"
  }
}
